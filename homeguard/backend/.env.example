# Copy to backend/.env. The app reads this file from the backend directory.
# Bind address stays on the loopback interface.
HOMEGUARD_API_HOST=127.0.0.1
HOMEGUARD_API_PORT=8000
HOMEGUARD_DATABASE_URL=sqlite:///./data/homeguard.db
HOMEGUARD_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# /16 is the largest network that can be saved. Discovery only runs on /24 or smaller.
HOMEGUARD_LARGEST_PREFIX_LENGTH=16
HOMEGUARD_DEFAULT_PREFIX_LENGTH=24
HOMEGUARD_SCAN_MIN_PREFIX_LENGTH=24
# Leave empty to use Nmap from PATH, or the usual Windows install folder.
HOMEGUARD_NMAP_PATH=
HOMEGUARD_COOKIE_SECURE=false
